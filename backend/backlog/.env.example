DB_URL=jdbc:postgresql://ep-old-darkness-a116xq97-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USER=neondb_owner
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=SET_A_LONG_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MS=3600000

# Initial admin-account seed passwords. There are NO built-in defaults: an unset
# var here means that account is NOT created on a fresh database (no guessable
# fallback). Set the ones you need on first boot; seeded accounts are forced to
# change the password on first login. Leave unset once accounts exist.
# ADMIN_PASSWORD_PRINCIPAL=
# ADMIN_PASSWORD_HOD=
# ADMIN_PASSWORD_OFFICE=
# ADMIN_PASSWORD_ADMIN=

# Boot behavior. Defaults (in application.properties) are dev-friendly; leave unset locally.
# In PRODUCTION, set these to harden the boot:
#   JPA_DDL_AUTO=validate   # verify schema only, never auto-migrate (add Neon columns manually first)
#   SQL_INIT_MODE=never     # skip schema.sql/data.sql demo seeding
# Optional local debugging:
#   JPA_SHOW_SQL=true       # log every SQL statement (off by default)
