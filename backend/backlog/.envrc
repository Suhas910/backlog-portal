# Pin this project to JDK 17 (matches pom.xml java.version / Spring Boot 3.4.3).
# Resolves whatever JDK 17 is installed on this Mac — no hardcoded path.
# Requires direnv (https://direnv.net). Run `direnv allow` once after cloning.
export JAVA_HOME="$(/usr/libexec/java_home -v 17)"
export PATH="$JAVA_HOME/bin:$PATH"
