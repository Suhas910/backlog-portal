# Copy this file to application.properties (which is gitignored). All secrets/config
# come from the .env file (loaded via the spring.config.import line below); the
# defaults here are safe fallbacks only.
spring.config.import=optional:file:.env[.properties]

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/database_name}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:YOUR_PASSWORD_HERE}
spring.datasource.hikari.maximum-pool-size=${DB_POOL_MAX_SIZE:5}
spring.datasource.hikari.minimum-idle=${DB_POOL_MIN_IDLE:1}

# Boot behavior. Flyway owns the schema (src/main/resources/db/migration); Hibernate
# only VALIDATES it (never mutates). Leave these at the defaults.
#   JPA_DDL_AUTO=validate  -> assert entities match the DB, never auto-migrate
#   JPA_SHOW_SQL=true       -> log every SQL statement (debugging only; off by default)
#   SQL_INIT_MODE=never     -> schema.sql/data.sql are retired; Flyway builds the schema
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:validate}
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=${JPA_FORMAT_SQL:false}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.sql.init.mode=${SQL_INIT_MODE:never}

# Flyway: baseline an existing (already-populated) DB at V1; a fresh empty DB runs V1
# to build the whole schema. New schema changes go in db/migration/V2__*.sql (V3, ...).
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174}
app.jwt.secret=${JWT_SECRET:CHANGE_ME_TO_A_LONG_RANDOM_BASE64_SECRET}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}
# absolute session ceiling — total lifetime a session may slide via refresh before
# a full re-login is forced, regardless of activity. Default 12h.
app.jwt.max-session-ms=${JWT_MAX_SESSION_MS:43200000}
# session cookie Secure flag. MUST stay true in production (https). Set false ONLY
# for local http dev, else the browser drops the httpOnly session cookie.
app.cookie.secure=${APP_COOKIE_SECURE:true}

# Initial admin-account seed passwords. No fallback default: a blank value means
# that account is NOT created on a fresh DB (no guessable default). Set via env.
# Only ADMIN and PRINCIPAL are seedable — HOD/DEPT_OFFICE accounts need a
# department, so create them through Manage Users after signing in.
admin.password.principal=${ADMIN_PASSWORD_PRINCIPAL:}
admin.password.admin=${ADMIN_PASSWORD_ADMIN:}

spring.application.name=backlog
server.port=8080
server.error.include-message=never
